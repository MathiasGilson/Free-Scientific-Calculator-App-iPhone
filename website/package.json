{
  "name": "convcalc-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "fetch-rates": "node scripts/fetch-rates.mjs",
    "build": "node scripts/fetch-rates.mjs && astro check && astro build",
    "preview": "astro preview",
    "test": "node --test test/engine.test.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "translate": "node scripts/translate-locales.mjs",
    "translate:dry": "node scripts/translate-locales.mjs --dry-run",
    "deploy": "npm run build && wrangler deploy && node scripts/indexnow.mjs --dist dist --host convcalc.app"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "astro": "^5.17.2",
    "lucide-static": "^0.468.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "terser": "^5.46.0",
    "wrangler": "^4.94.0"
  }
}
