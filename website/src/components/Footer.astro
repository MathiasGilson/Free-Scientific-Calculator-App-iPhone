---
import { getTranslations, localizedPath, locales, localeNames, REPO, type Locale } from "../utils/i18n";
import { GRID } from "../lib/tools.js";
const { locale, path, englishOnly } = Astro.props as { locale: Locale; path: string; englishOnly?: boolean };
const t = getTranslations(locale);
const p = (x: string) => localizedPath(locale, x);
const tools = t.tools as Record<string, { label: string; h1: string }>;
const features = t.features as Record<string, { label: string }>;
const compare = t.compare as Record<string, { label: string }>;
---
<footer class="foot">
  <div class="foot-in">
    <div class="foot-a"><p class="brand-f"><img src="/icon.png" alt="" width="24" height="24" loading="lazy" />ConvCalc</p><p>{t.footer.tagline}</p></div>
    <div class="foot-c foot-tools"><h2>{t.footer.tools}</h2><ul>{GRID.map(([k]) => <li><a href={p(`/tools/${k}`)}>{tools[k].h1}</a></li>)}</ul></div>
    <div class="foot-c"><h2>{t.footer.features}</h2><ul>{Object.keys(features).map((k) => <li><a href={p(`/features/${k}`)}>{features[k].label}</a></li>)}</ul>
      <h2 class="mt">{t.footer.compare}</h2><ul>{Object.keys(compare).map((k) => <li><a href={p(`/compare/${k}`)}>{compare[k].label}</a></li>)}</ul></div>
    <div class="foot-c"><h2>{t.footer.more}</h2><ul>
      <li><a href="/convert">{t.footer.conversions}</a></li>
      <li><a href="/privacy">{t.footer.privacy}</a></li>
      <li><a href="/support">{t.footer.support}</a></li>
      <li><a href={REPO}>{t.footer.source}</a></li></ul>
      <h2 class="mt">{t.footer.language}</h2>
      <ul class="langs">{locales.map((l) => <li><a href={englishOnly ? localizedPath(l, "/") : localizedPath(l, path)} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>{localeNames[l]}</a></li>)}</ul></div>
  </div>
</footer>
