---
import Layout from "../../layouts/Layout.astro";
import AppStore from "../../components/AppStore.astro";
import Shot from "../../components/Shot.astro";
import { CONVERSIONS, relatedTo } from "../../utils/conversions.js";
import rates from "../../data/rates.json";
export const getStaticPaths = () => CONVERSIONS.map((c: any) => ({ params: { slug: c.slug }, props: { c } }));
const { c } = Astro.props as any;
const related = relatedTo(c);
const toolName = (c.t === "temperature" ? "Temperature" : c.t === "currency" ? "Currency" : c.t[0].toUpperCase() + c.t.slice(1));
const shot = c.currency ? "currency" : c.t === "length" ? "tool-length" : c.t === "temperature" ? "tool-temperature" : "converterGrid";
---
<Layout title={c.title} description={c.description} locale="en" path={`/convert/${c.slug}`} pageType="conversion" englishOnly appSchema>
<main class="wrap">
  <section class="first">
    <h1>{c.h1}</h1>
    <div class="conv" data-conv data-tool={c.t} data-from={c.fromLabel} data-to={c.toLabel}>
      <label><input data-in inputmode="decimal" value={c.currency ? "100" : "10"} aria-label={c.fromName} /><span>{c.fromLabel}</span></label>
      <div class="eq">=</div>
      <div class="res"><output data-out>{c.out}</output><span>{c.toLabel}</span></div>
    </div>
    <p><b>{c.formula}</b></p>
    <div class="mt-cta"><AppStore locale="en" placement="conversion_top" /></div>
    {c.defs.length > 0 && <p>{c.defs.join(" ")}</p>}
    {c.currency && <small class="sm">Rate from {rates.date}, for reference only, from <a href="https://www.exchangerate-api.com">Rates By Exchange Rate API</a>. Your bank or card issuer will use its own rate.</small>}
  </section>
  <section><h2>{c.name} chart</h2>
    <div class="chart">{c.rows.map(([a, b]: string[]) => <div><span>{a}</span><b>{b}</b></div>)}</div>
  </section>
  <section><h2>Worked example</h2><p>{c.example}</p></section>
  <section class="cta two">
    <div><h2>{c.currency ? "Convert currency on your iPhone" : `Every ${c.t} unit at once, on your iPhone`}</h2><p>ConvCalc shows all the {toolName.toLowerCase()} units together as you type, alongside a scientific calculator and 19 other tools. Free, with no ads.</p><div class="mt-cta"><AppStore locale="en" placement="conversion" /></div></div>
    <div class="side-phone"><Shot name={shot} alt={`ConvCalc ${toolName.toLowerCase()} screen`} /></div>
  </section>
  <section><h2>Related conversions</h2><div class="rel">{related.map((r: any) => <a href={`/convert/${r.slug}`}>{r.name}</a>)}<a href={`/tools/${c.t}`}>{toolName} converter</a></div></section>
</main>
<script>
  import { TOOLS } from "../../lib/tools.js";
  import { fmt } from "../../lib/engine.js";
  import rates from "../../data/rates.json";
  const r = document.querySelector("[data-conv]") as HTMLElement;
  const i = r.querySelector("[data-in]") as HTMLInputElement, o = r.querySelector("[data-out]") as HTMLElement;
  const { tool, from, to } = r.dataset;
  const convert = (v: number) => {
    if (tool === "currency") return (v * (rates.rates as any)[to!]) / (rates.rates as any)[from!];
    const us = (TOOLS as any)[tool!].units;
    return us.find((u: any) => u.label === to).from(us.find((u: any) => u.label === from).to(v));
  };
  const up = () => { const v = parseFloat(i.value); i.style.width = Math.max(i.value.length, 1) + 0.4 + "ch"; o.textContent = Number.isFinite(v) ? fmt(convert(v)) : "0"; };
  i.addEventListener("input", up);
  up();
</script>
</Layout>
