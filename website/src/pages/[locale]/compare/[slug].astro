---
import ComparePage from "../../../components/ComparePage.astro";
import en from "../../../locales/en.json";
import { nonDefaultLocales } from "../../../utils/i18n";
export const getStaticPaths = () => nonDefaultLocales.flatMap((locale) => Object.keys(en.compare).map((slug) => ({ params: { locale, slug }, props: { locale } })));
const { locale } = Astro.props;
---
<ComparePage locale={locale} slug={Astro.params.slug} />
