---
import "../lib/base.css";
const { title, fonts, class: c } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&family=Inter:wght@300;400;500;600&display=swap`} />
<meta name="robots" content="noindex" />
</head>
<body class={c}>
<slot />
<a class="switch" href="/">All directions</a>
<script>import "../lib/demo.js";</script>
</body>
</html>
