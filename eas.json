{
    "cli": {
        "version": ">= 16.0.0",
        "promptToConfigurePushNotifications": false,
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "node": "22.12.0",
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "node": "22.12.0",
            "autoIncrement": true,
            "distribution": "internal"
        },
        "emulator": {
            "ios": {
                "simulator": true
            }
        },
        "production": {
            "node": "22.12.0",
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appName": "Free Calculator with History",
                "companyName": "Free Calculator no ads"
            }
        }
    }
}
